      viewBox="0 0 16 9"
      fill="none"
    >
      <path d="M15 0.75L11.5001 3.75L8 6.75L1 0.749999" stroke="black" stroke-width="1.5"/>
    </svg>
  </div>
  <svg xmlns="http://www.w3.org/2000/svg" width="1402" height="2" viewBox="0 0 1402 2" fill="none">
    <path d="M1 0.75L1401 0.749878" stroke="#C8C8C8" stroke-linecap="round"/>
  </svg>
</div>
