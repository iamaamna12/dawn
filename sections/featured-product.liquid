<product-info
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="false"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'section-featured-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {% unless section.settings.product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  <section class="color-{{ section.settings.color_scheme }} {% if section.settings.secondary_background %}background-secondary{% else %}gradient{% endif %}">
    <div class="page-width section-{{ section.id }}-padding{% if section.settings.secondary_background %} isolate{% endif %}">
      <div class="featured-product product product--{{ section.settings.media_size }} grid grid--1-col gradient color-{{ section.settings.color_scheme }} product--{{ section.settings.media_position }}{% if section.settings.secondary_background == false %} isolate{% endif %} {% if product.media.size > 0 or section.settings.product == blank %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
        <div class="grid__item product__media-wrapper">
          {%- unless placeholder -%}
            {% render 'product-media-gallery', product: product, variant_images: variant_images, limit: 5 %}
          {%- else -%}
            <div class="product__media-item">
              <div class="product-images-container">
                <!-- Small images on the left -->
                <div class="small-images">
                  {%- for image in product.images limit: 5 %}
                    <div class="small-image">
                      <img
                        src="{{ image.src | img_url: '100x' }}"
                        alt="{{ image.alt | escape }}"
                        onclick="changeMainImage('{{ image.src | img_url: '800x' }}')"
                      >
                    </div>
                  {%- endfor %}
                </div>

                <!-- Main image on the right -->
                <div class="main-image">
                  <img
                    id="main-image"
                    src="{{ product.featured_image | img_url: '800x' }}"
                    alt="{{ product.featured_image.alt | escape }}"
                  >
                </div>
              </div>
            </div>
          {%- endunless -%}
        </div>

        <div class="product__info-wrapper grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container"
            data-section="{{ section.id }}"
            data-url="{{ product.url }}"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}

            <h2 class="product__title">{{ product.title | escape }}</h2>

            <div id="price-{{ section.id }}" role="status">
              <div class="product__price">
                {{ 'products.product.price' | t }}:
                {{ product.price | money }}
              </div>
            </div>

            <div class="product-variants">
              <h3>Variants</h3>
              {% if product.variants.size > 1 %}
                <ul class="product__variant-list">
                  {%- for variant in product.variants -%}
                    <li class="variant">
                      <label for="variant-{{ variant.id }}">{{ variant.title }}</label>
                      <input type="radio" id="variant-{{ variant.id }}" name="variant" value="{{ variant.id }}">
                    </li>
                  {%- endfor %}
                </ul>
              {% else %}
                <div>No variants available</div>
              {% endif %}
            </div>

            <div class="product-options">
              <h3>Options</h3>
              <div class="options__box">
                <label for="size">Size:</label>
                <select id="size" name="size">
                  <option value="small">Small</option>
                  <option value="medium">Medium</option>
                  <option value="large">Large</option>
                </select>
              </div>
              <div class="options__box">
                <label for="color">Color:</label>
                <select id="color" name="color">
                  <option value="red">Red</option>
                  <option value="blue">Blue</option>
                  <option value="green">Green</option>
                </select>
              </div>
            </div>

            <div class="quantity-selector">
              <label for="quantity">Quantity:</label>
              <input type="number" id="quantity" name="quantity" min="1" max="10" value="1">
            </div>

            <div class="buy-buttons">
              <button class="btn btn--add-to-cart">Add to Cart</button>
              <button class="btn btn--buy-now">Buy Now</button>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  <script>
    function changeMainImage(imageUrl) {
      document.getElementById('main-image').src = imageUrl;
    }
  </script>
</product-info>

{% schema %}
{
  "name": "Product Page",
  "tag": "section",
  "class": "section-product-page",
  "blocks": [
    {
      "type": "product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ]
}
{% endschema %}
