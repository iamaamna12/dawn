<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{% render 'secondary-nav-bar' %}

<style>
  /* Header container layout */
  .header {
    display: flex;
    width: 100%;
    padding: 24px 20px;
    justify-content: space-between;
    align-items: center;
    background-color: #fff; /* Background color for the header */
  }

  /* Logo Position */
  .header__heading {
    display: flex;
    align-items: center;
  }

  /* Logo Image */
  .header__heading-logo-wrapper img {
    width: 279px;
    height: 81.75px;
  }

  /* Search bar styling */
  .header__search-wrapper {
    display: flex;
    align-items: center;
    flex: 1;
    margin-bottom: 10px;
  }

  .header__search-input {
    padding: 10px;
    width: 100%;
    border: 1px solid #000;
    border-radius: 4px;
    margin-right: 10px;
  }

  .header__search-button {
    background-color: #004f9f;
    padding: 10px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  /* Navbar menu for larger screens */
  .header__menu {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px; /* Space between items */
    flex: 1;
  }

  .header__menu a {
    color: #000;
    font-family: Inter;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    text-decoration: none;
    padding: 10px;
  }

  .header__menu a.action {
    color: #ff4814; /* Orange for 'Aktion %' */
  }

  /* Show the hamburger icon on mobile/tablet */
  @media (max-width: 750px) {
    .header__menu {
      display: none; /* Hide menu items on small screens */
    }

    .navbar__hamburger {
      display: block; /* Show hamburger icon */
      cursor: pointer;
    }

    /* Hamburger menu dropdown */
    .hamburger-menu {
      display: none;
      flex-direction: column;
      gap: 10px;
      position: absolute;
      background-color: white;
      top: 70px;
      left: 20px;
      width: 200px;
      padding: 20px;
      border-radius: 4px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .hamburger-menu a {
      color: #000;
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
    }

    /* Show menu when the hamburger is clicked */
    .hamburger-menu.show {
      display: flex;
    }
  }

  /* For Tablet */
  @media (max-width: 992px) {
    .header__menu {
      display: flex;
      gap: 20px;
    }

    .navbar__hamburger {
      display: block; /* Show hamburger icon */
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hamburgerIcon = document.querySelector('.navbar__hamburger');
    const hamburgerMenu = document.querySelector('.hamburger-menu');

    hamburgerIcon.addEventListener('click', function () {
      hamburgerMenu.classList.toggle('show');
    });
  });
</script>

<header class="header">
  <!-- Logo Section -->
  <div class="header__heading">
    {% assign logo_url = 'logoclr.png' | asset_url %}
    <img src="{{ logo_url }}" alt="logo">
  </div>

  <!-- Search Bar Section -->
  <div class="header__search-wrapper">
    <input type="text" placeholder="Suche" class="header__search-input">
    <button class="header__search-button">
      <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
    </button>
  </div>

  <!-- Menu for desktop and tablet -->
  <div class="header__menu">
    <a href="#">Schilder</a>
    <a href="#">Befestigen und Montieren</a>
    <a href="#">Baustellenabsicherung</a>
    <a href="#">Straßenausstattung</a>
    <a href="#">Stadtmobiliar</a>
    <a href="#">Grünpflege</a>
    <a href="#">Betriebsbedarf</a>
    <a href="#" class="action">Aktion %</a>
  </div>

  <!-- Hamburger icon for mobile/tablet -->
  <div class="navbar__hamburger">
    <span>&#9776;</span>
    <!-- Hamburger Icon -->
  </div>

  <!-- Hamburger Menu Dropdown for mobile/tablet -->
  <div class="hamburger-menu">
    <a href="#">Schilder</a>
    <a href="#">Befestigen und Montieren</a>
    <a href="#">Baustellenabsicherung</a>
    <a href="#">Straßenausstattung</a>
    <a href="#">Stadtmobiliar</a>
    <a href="#">Grünpflege</a>
    <a href="#">Betriebsbedarf</a>
    <a href="#" class="action">Aktion %</a>
  </div>
</header>
