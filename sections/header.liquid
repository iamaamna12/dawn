<style>
  /* Header container layout */
  /* Header container layout */
  .header {
    display: flex;
    width: 100%;
    padding: 24px 20px;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-direction: column; /* Make the header stack vertically */
  }

  /* Logo Position */
  .header__heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Logo styling */
  .header__heading-logo-wrapper {
    display: flex;
    align-items: center;
    height: auto;
    width: auto;
  }

  /* Search bar styling */
  .header__search-wrapper {
    display: flex;
    align-items: center;
    flex: 1;
    margin-bottom: 10px; /* Add space below the search bar */
  }

  .header__search-input {
    padding: 10px;
    width: 100%;
    border: 1px solid #000;
    border-radius: 4px;
    margin-right: 10px;
  }

  .header__search-button {
    background-color: #004f9f;
    padding: 10px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  /* Navbar menu */
  .header__menu {
    display: flex;
    flex-direction: column; /* Stack items vertically */
    justify-content: flex-start;
    gap: 10px;
    width: 100%; /* Ensure it takes up full width */
  }

  .header__menu a {
    color: #000;
    font-family: Inter;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    text-decoration: none;
    padding: 10px;
  }

  .header__menu a.action {
    color: #ff4814; /* Orange for 'Aktion %' */
  }

  /* For mobile view */
  @media (max-width: 750px) {
    .header {
      flex-direction: column;
      align-items: flex-start;
    }

    /* Hide menu for mobile and show hamburger */
    .header__menu {
      display: none;
    }

    .navbar__hamburger {
      display: block;
      cursor: pointer;
    }

    /* Show hamburger on smaller screens */
    .hamburger-menu {
      display: block;
      flex-direction: column;
      gap: 10px;
      position: absolute;
      background-color: white;
      top: 70px;
      left: 20px;
      width: 200px;
      padding: 20px;
      border-radius: 4px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .hamburger-menu a {
      color: #000;
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hamburgerIcon = document.querySelector('.navbar__hamburger');
    const hamburgerMenu = document.querySelector('.hamburger-menu');

    hamburgerIcon.addEventListener('click', function () {
      hamburgerMenu.classList.toggle('show');
    });
  });
</script>

<header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}">
  <div class="header__heading">
    {% assign logo_url = 'logoclr.png' | asset_url %}
    <img src="{{ logo_url }}" alt="logo" style="width: 279px; height:81.75px; margin: 20px;">
  </div>

  <div class="header__search-wrapper">
    <input type="text" placeholder="Suche" class="header__search-input">
    <button class="header__search-button">
      <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
    </button>
  </div>

  <!-- Menu for larger screens -->
  <div class="header__menu">
    <a href="#">Schilder</a>
    <a href="#">Befestigen und Montieren</a>
    <a href="#">Baustellenabsicherung</a>
    <a href="#">Straßenausstattung</a>
    <a href="#">Stadtmobiliar</a>
    <a href="#">Grünpflege</a>
    <a href="#">Betriebsbedarf</a>
    <a href="#" class="action">Aktion %</a>
  </div>

  <!-- Hamburger menu for mobile -->
  <div class="navbar__hamburger">
    <span>&#9776;</span>
  </div>

  <!-- Hamburger dropdown -->
  <div class="hamburger-menu">
    <a href="#">Schilder</a>
    <a href="#">Befestigen und Montieren</a>
    <a href="#">Baustellenabsicherung</a>
    <a href="#">Straßenausstattung</a>
    <a href="#">Stadtmobiliar</a>
    <a href="#">Grünpflege</a>
    <a href="#">Betriebsbedarf</a>
    <a href="#" class="action">Aktion %</a>
  </div>
</header>
