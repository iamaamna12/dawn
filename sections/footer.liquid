{% comment %}Theme footer setup{% endcomment %}

<footer class="footer">
  <div class="footer__top">
    <div class="footer__column footer__newsletter">
      {% assign logo_url = 'logo.png' | asset_url %}
      <img src="{{ logo_url }}" alt="Logo">
      <p>
        Für Fachinformationen anmelden: exklusive, kostenlose Informationen für Mitglieder erhalten. Attraktive
        Sonderkonditionen. Innovative Aktionen.
      </p>
      <form action="#" method="post">
        <input type="email" name="email" placeholder="Email" required>
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
      <p>Ich habe die Datenschutzbestimmungen zur Kenntnis genommen.</p>
    </div>

    <div class="footer__column footer__contact">
      <strong>Kontakt:</strong>
      <p>08152 - 9893040</p>
      <p>info@kommondo.de</p>
      <br>
      {% assign logo_url = 'pay1.png' | asset_url %}
      <img src="{{ logo_url }}" alt="Rechnung">

      {% assign paypal_url = 'image-5.png' | asset_url %}
      <img src="{{ paypal_url }}" alt="PAYPAL">

      {% assign visa_url = 'visa.png' | asset_url %}
      <img src="{{ visa_url }}" alt="Mastercard/Visa">

      {% assign delivery_url = 'delivery.png' | asset_url %}
      <img src="{{ delivery_url }}" alt="Certification">
    </div>

    <div class="footer__column footer__whatsapp">
      <strong>Oder per Whatsapp</strong>
      <p>+49 170 5798830</p>
    </div>
  </div>

  <div class="footer__bottom">
    <p>
      Onlineshop für B2B und B2G Kunden. * Alle Preise rein netto zzgl. der aktuell gesetzlich gültiger Mehrwertsteuer.
      Fracht zzgl. 9 % vom Netto-Auftragswert und ggf. Nachnahmegebühren, wenn nicht anders angegeben.
    </p>
    <p>© Kommondo GmbH. All rights reserved.</p>
  </div>
</footer>
